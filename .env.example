# Aplicación
NODE_ENV=development
APP_ENV=development
PORT=3000
API_PREFIX=api

# JWT y Seguridad
JWT_SECRET=contratacion-dev-secret
JWT_EXPIRES_IN=1h
CORS_ORIGIN=*

# Base de Datos (MySQL Docker en puerto host 3307)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DATABASE=contratacion_db
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Administrador Inicial (Seed)
SEED_ADMIN_EMAIL=admin@contratacion.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_NOMBRE=Administrador
